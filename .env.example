# Dopsy web server
DOPSY_ADDR=127.0.0.1:8080
DOPSY_TIMEZONE=Europe/Berlin

# Docker Engine. The Compose setup points this at Dopsy's restricted proxy.
DOPSY_DOCKER_HOST=http://docker-proxy:2375
DOPSY_DEMO_MODE=false

# Bring your own OpenAI-compatible model endpoint.
DOPSY_LLM_BASE_URL=https://api.openai.com/v1
DOPSY_LLM_API_KEY=
DOPSY_LLM_MODEL=

# Guardrails for a single diagnosis.
DOPSY_MAX_AGENT_STEPS=6
DOPSY_MAX_TOOL_CALLS=10
DOPSY_MAX_TOOL_OUTPUT_BYTES=524288
DOPSY_MAX_LOG_LINES=2000
DOPSY_MAX_LOG_BYTES=262144

# Short-lived server-side conversation context and concurrency.
DOPSY_CONVERSATION_TTL=30m
DOPSY_MAX_CONVERSATIONS=128
DOPSY_MAX_CONVERSATION_TURNS=12
DOPSY_MAX_CONVERSATION_BYTES=131072
DOPSY_MAX_CONCURRENT_DIAGNOSES=2
DOPSY_REQUEST_TIMEOUT=60s
